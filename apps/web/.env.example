# Kopieer naar .env.local en pas aan. Zet hier nooit echte wachtwoorden in de repository.
DATABASE_URL=postgres://mescid:mescid@localhost:5432/mescid

# Alleen voor het vullen van de demo-database (npm run db:seed).
# Laat leeg om een willekeurig wachtwoord te laten genereren en eenmalig te tonen.
SEED_PASSWORD=

# Optioneel: Diyanet Awqat Salah API. Vraag zelf een account aan bij Diyanet.
# Zonder deze gegevens werkt de app gewoon; de Diyanet-import staat dan uit.
DIYANET_EMAIL=
DIYANET_PASSWORD=
